{
  // i18n
  "i18n-ally.sortKeys": true,
  "i18n-ally.keystyle": "flat",
  "i18n-ally.localesPaths": ["packages/website/src/translations"],

  // java
  "files.exclude": {
    "target": true
  },
  "java.project.sourcePaths": ["data/planetiler"],
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.import.maven.enabled": true,
  "java.format.settings.url": "https://raw.githubusercontent.com/google/styleguide/eaa0a0/eclipse-java-google-style.xml",
  "java.format.settings.profile": "GoogleStyle",
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },
  "java.compile.nullAnalysis.mode": "automatic"
}
